{
  "version": 2,
  "timely_connector": {
    "provider": "Timely Agent",
    "workspace_url": "https://timelyai.io/upstage-jnu/timely-agent",
    "model": "Solar Pro 4",
    "execution_mode": "external_github_connector",
    "secret_environment_variable": "TIMELY_AGENT_API_KEY"
  },
